# ---- Database (Neon / Supabase PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
TELEGRAM_WEBHOOK_SECRET="a-long-random-string"
ADMIN_TELEGRAM_IDS="111111111,222222222"

# ---- Vercel Cron ----
# Vercel sets this for you in production and sends it as
# `Authorization: Bearer <secret>` to /api/cron/regular-payments.
# Set it locally too, otherwise the route refuses every request.
CRON_SECRET="a-long-random-string"

# ---- Web Dashboard auth ----
DASHBOARD_PASSWORD="your-admin-password"
AUTH_SECRET="a-long-random-string"
